{
    "name": "schachbulle/contao-allinkl-bundle",
    "type": "contao-bundle",
    "description": "Verwaltet Domains, Subdomains, DNS, Postfächer, Datenbanken, FTP-Zugänge, Cronjobs und mehr eines All-Inkl-Webhostings über die KAS-API direkt im Contao-Backend.",
    "keywords": [
        "contao",
        "all-inkl",
        "kas",
        "kasapi",
        "webhosting",
        "domains",
        "dns"
    ],
    "homepage": "https://github.com/Samson1964/contao-allinkl-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "contao/core-bundle": "^4.13 || ^5.7",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoAllinklBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoAllinklBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoAllinklBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-allinkl-bundle/issues",
        "source": "https://github.com/Samson1964/contao-allinkl-bundle"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
